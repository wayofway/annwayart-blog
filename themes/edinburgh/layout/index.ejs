<%
  var list = [];
  if (page.posts && typeof page.posts.forEach === 'function') {
    page.posts.forEach(function (post) { list.push(post); });
  }
%>
<% if (list.length) { %>
  <% var lead = list[0]; %>
  <a class="leaf" href="<%- url_for(lead.path) %>">
    <span class="painting">
      <img src="<%- url_for(lead.cover_image || theme.default_cover_image) %>" alt="">
    </span>
    <span class="inscription">
      <h2 class="vtitle"><%= lead.title || theme.default_post_title || 'Untitled' %></h2>
      <span class="meta">
        <%- partial('_partial/inscription', {post: lead, vertical: true}) %>
        <%- partial('_partial/seals', {post: lead}) %>
      </span>
    </span>
  </a>
  <% if (list.length > 1) { %>
    <div class="index">
      <% list.slice(1).forEach(function (post) { %>
        <%- partial('_partial/list', {item: post}) %>
      <% }) %>
    </div>
  <% } %>
<% } %>
<% if (page.total > 1) { %>
  <nav class="pager">
    <% if (page.prev) { %>
      <a href="<%- url_for(page.prev_link) %>"><span class="zh">上一开</span><span class="en">Previous</span></a>
    <% } else { %>
      <span class="is-disabled"><span class="zh">上一开</span><span class="en">Previous</span></span>
    <% } %>
    <span class="date"><%= page.current %> / <%= page.total %> <span class="zh">开</span><span class="en">leaf</span></span>
    <% if (page.next) { %>
      <a href="<%- url_for(page.next_link) %>"><span class="zh">下一开</span><span class="en">Next leaf</span></a>
    <% } else { %>
      <span class="is-disabled"><span class="zh">下一开</span><span class="en">Next leaf</span></span>
    <% } %>
  </nav>
<% } %>
