<a class="back" href="<%- url_for('/') %>">
  <span class="zh">返回册页</span><span class="en">Back to the album</span>
</a>
<article class="essay">
  <div class="painting">
    <img src="<%- url_for(item.cover_image || theme.default_cover_image) %>" alt="<%= item.title || theme.default_post_title || 'Untitled' %>">
  </div>
  <h1><%= item.title || theme.default_post_title || 'Untitled' %></h1>
  <div class="meta">
    <%- partial('_partial/seals', {post: item}) %>
    <%- partial('_partial/inscription', {post: item, vertical: false}) %>
  </div>
  <div class="essay-body">
    <%- item.content %>
  </div>
  <nav class="neighbors">
    <span>
      <% if (page.next) { %>
        <a href="<%- url_for(page.next.path) %>">
          <span class="zh">上一篇</span><span class="en">Previous</span>
          · <%= page.next.title %>
        </a>
      <% } %>
    </span>
    <span>
      <% if (page.prev) { %>
        <a href="<%- url_for(page.prev.path) %>">
          <span class="zh">下一篇</span><span class="en">Next</span>
          · <%= page.prev.title %>
        </a>
      <% } %>
    </span>
  </nav>
</article>
