<head>
  <meta charset="utf-8">
  <script>
    (function () {
      var theme = "paper";
      var lang = "zh";
      try {
        var savedTheme = localStorage.getItem("album-theme");
        var savedLang = localStorage.getItem("album-lang");
        if (savedTheme === "paper" || savedTheme === "night") theme = savedTheme;
        else if (window.matchMedia("(prefers-color-scheme: dark)").matches) theme = "night";
        if (savedLang === "zh" || savedLang === "en") lang = savedLang;
      } catch (error) {}
      var root = document.documentElement;
      root.setAttribute("data-theme", theme);
      root.setAttribute("data-lang", lang);
      root.lang = lang === "en" ? "en" : "zh-CN";
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%
    var title = [];
    if (page.current > 1) title.push(__('page', page.current));
    if (page.title) title.push(page.title);
    title.push(config.title);
  %>
  <title><%= title.join(' - ') %></title>
  <link rel="icon" href="<%- url_for('/favicon/favicon.ico') %>">
  <% if (page.description){ %>
    <meta name="description" content="<%= page.description %>">
  <% } else if (config.description){ %>
    <meta name="description" content="<%= config.description %>">
  <% } else if (page.excerpt){ %>
    <meta name="description" content="<%= strip_html(page.excerpt).replace(/^\s*/, '').replace(/\s*$/, '') %>">
  <% } else if (page.content){ %>
    <meta name="description" content="<%= strip_html(page.content).replace(/^\s*/, '').replace(/\s*$/, '').substring(0, 150) %>">
  <% } %>
  <% if (config.author){ %>
    <meta name="author" content="<%= config.author %>">
  <% } %>
  <%- css('css/styles.css') %>
</head>
