<a class="row" href="<%- url_for(item.path) %>">
  <span class="thumb">
    <span class="painting">
      <img src="<%- url_for(item.cover_image || theme.default_cover_image) %>" alt="">
    </span>
  </span>
  <span class="name"><%= item.title || theme.default_post_title || 'Untitled' %></span>
  <%- partial('_partial/inscription', {post: item, vertical: false}) %>
</a>
