<%
  var menuCopy = {
    Home: { zh: '首页', en: 'Home' },
    Nickname: { zh: '爱称', en: 'Names' },
    Learning: { zh: 'Learning', en: 'Learning' },
    About: { zh: '关于', en: 'About' },
    Github: { zh: 'Github', en: 'Github' },
    Instagram: { zh: 'Instagram', en: 'Instagram' }
  };
%>
<header class="site-head">
  <div class="bar">
    <a class="brand" href="<%- url_for('/') %>">
      安安戈
    </a>
    <nav class="site-nav">
      <% for (var name in config.menu) {
        var href = config.menu[name];
        var external = /^https?:\/\//.test(href);
        var copy = menuCopy[name] || { zh: name, en: name };
        var current = false;
        if (!external) {
          if (name === 'Home') current = is_home() || is_post();
          else current = is_current(href);
        }
      %>
        <a href="<%- url_for(href) %>"<% if (external) { %> target="_blank" rel="noreferrer"<% } %><% if (current) { %> aria-current="page"<% } %>>
          <span class="zh"><%= copy.zh %></span><span class="en"><%= copy.en %></span>
        </a>
      <% } %>
    </nav>
    <div class="tools">
      <button type="button" id="lang" aria-pressed="true">
        <span class="zh">中文</span><span class="en">EN</span>
      </button>
      <button type="button" id="theme" aria-pressed="false">
        <span class="label-paper"><span class="zh">晨宣</span><span class="en">Paper</span></span>
        <span class="label-night"><span class="zh">夜读</span><span class="en">Night</span></span>
      </button>
    </div>
  </div>
</header>
